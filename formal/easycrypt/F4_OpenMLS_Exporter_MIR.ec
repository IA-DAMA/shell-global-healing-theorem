(* Generated by exporter_mir.py. Outer None denotes unreachable MIR. *)
require import AllCore Int List F4_OpenMLS_Exporter_Algorithm.

op f4_export_mir (n : int) (active static_log runtime_log : bool)
    (derived : f4_derived_bytes option) : f4_derived_bytes option option =
  let bb22 = fun (r : f4_derived_bytes option) => Some r in
  let bb21 = bb22 None in
  let bb20 = bb22 None in
  let bb19 = bb22 (Some (oget derived)) in
  let bb18 = None<:f4_derived_bytes option> in
  let bb17 = if derived = None then bb20 else bb19 in
  let bb16 = bb17 in
  let bb15 = bb16 in
  let bb14 = bb15 in
  let bb13 = bb14 in
  let bb12 = bb13 in
  let bb11 = if active then bb12 else bb21 in
  let bb10 = bb11 in
  let bb9 = bb22 None in
  let bb8 = bb9 in
  let bb7 = bb8 in
  let bb6 = bb7 in
  let bb5 = if runtime_log then bb6 else bb9 in
  let bb4 = bb5 in
  let bb3 = bb4 in
  let bb2 = if static_log then bb3 else bb9 in
  let bb1 = bb2 in
  let bb0 = if 65535 < n then bb1 else bb10 in
  bb0.

type f4_mir_stage = [ContextHash | DeriveLabel | ExpandExported].

op f4_derive_mir (hashed : f4_context_hash option) (labeled : f4_kdf_secret option)
    (expanded : f4_derived_bytes option) =
  if hashed = None then ([ContextHash], None)
  else if labeled = None then ([ContextHash; DeriveLabel], None)
  else if expanded = None then ([ContextHash; DeriveLabel; ExpandExported], None)
  else ([ContextHash; DeriveLabel; ExpandExported], (Some (oget expanded))).
