require import AllCore List.
require import F4_L2_Product_CC.
require import F4_Linear_Temporal_Certificate.
require import F4_CC_Observation_Prefix.
require import F4_Removal_Route_Closure.
require import F4_Epoch_Schedule_Cut.

(* L3 connects the exact twelve-operation capability ledger to the linear
   temporal certificate.  The four coordinates below are deliberately not
   cryptographic values: they are the symbolic over-approximation required by
   GLOBAL_V1 C1.  In particular, CommitInput and PskInput may originate in
   different installations and at different times. *)

op l3_material_seen (s : native) (m : f4_material) =
  if m = InitInput then s.`view.`1 else
  if m = CommitInput then s.`view.`2 else
  if m = PskInput then s.`view.`3 else
  if m = F4_Epoch_Schedule_Cut.Output then s.`view.`4 else false.

op l3_seen (s : native) (x : f4_route_fact) =
  with x = Bytes i    => false
  with x = Opening i  => false
  with x = Opened i   => false
  with x = Material m => l3_material_seen s m.

op l3_joint_rule (r : f4_route_rule) =
  r = (Material CommitInput, Material PskInput,
       Material F4_Epoch_Schedule_Cut.Output).

op l3_rules (s : native) (opn : cmd) =
  if s.`up /\ (opn = Resync \/ opn = Retry) then l3_joint_rule else no_rules.

op l3_delta (s : native) (opn : cmd) (x : f4_route_fact) =
  l3_seen (physical s opn) x /\ !l3_seen s x.

op l3_phase (s : native) (opn : cmd) : f4_phase =
  (l3_rules s opn, l3_delta s opn).

op l3_phases (s : native) (ops : cmd list) : f4_phase list =
  with ops = [] => []
  with ops = opn :: tail => l3_phase s opn :: l3_phases (physical s opn) tail.

(* This is the calculable row instance for every L2 case.  It proves all
   three matrix obligations: bounded coordinates, monotone possession, and
   y_a + y_b - y_c <= 1 for the only joint derivation rule. *)
lemma l3_seen_step_mono (s : native) (opn : cmd) (x : f4_route_fact) :
  l3_seen s x => l3_seen (physical s opn) x.
proof.
  case: x => [i|i|i|m].
  + by rewrite /l3_seen.
  + by rewrite /l3_seen.
  + by rewrite /l3_seen.
  case: m; case: opn;
    rewrite /l3_seen /l3_material_seen /physical /=;
    try (case s.`up); simplify;
    rewrite /additem /merge /readout /=; smt().
qed.

lemma l3_readout_closed (s : native) :
  closed l3_joint_rule (l3_seen {|s with view = readout s.`view|}).
proof.
  rewrite /closed /l3_joint_rule => a b c hr ha hb.
  case: hr => /=.
  rewrite /l3_seen /l3_material_seen /readout /=.
  move: ha hb; rewrite /l3_seen /l3_material_seen /readout /=; smt().
qed.

lemma l3_step_joint_closed (s : native) (opn : cmd) :
  closed (l3_rules s opn) (l3_seen (physical s opn)).
proof.
  case: opn; rewrite /l3_rules /physical /=; case s.`up; simplify;
    try (rewrite /closed /no_rules; smt());
    exact (l3_readout_closed s).
qed.

lemma l3_each_l2_case_row (s : native) (opn : cmd) :
  row_ok (l3_phase s opn)
    (indicator (l3_seen s))
    (indicator (l3_seen (physical s opn))).
proof.
  apply row_embed.
  + rewrite /contains /plus /l3_phase /l3_delta => x [hold | hnew].
    - exact (l3_seen_step_mono s opn x hold).
    by elim hnew.
  exact (l3_step_joint_closed s opn).
qed.

(* Exact finite-prefix certificate.  The final physical state supplies the
   final zero row; preceding rows are generated by l3_each_l2_case_row. *)
lemma l3_trace_linear_certificate (ops : cmd list) (s : native) :
  ! has_item (foldl physical s ops).`view F4_CC_Observation_Prefix.Output =>
  linear_cert (l3_phases s ops) (indicator (l3_seen s))
    (Material F4_Epoch_Schedule_Cut.Output).
proof.
  elim: ops s => [|opn tail ih] s /=.
  + rewrite /l3_seen /indicator /has_item; smt().
  move=> hfinal; exists (indicator (l3_seen (physical s opn))).
  split; first exact (l3_each_l2_case_row s opn).
  exact (ih (physical s opn) hfinal).
qed.

lemma l3_trace_symbolic_cut (ops : cmd list) (s : native) :
  ! has_item (foldl physical s ops).`view F4_CC_Observation_Prefix.Output =>
  ! final_view (l3_phases s ops) (l3_seen s)
      (Material F4_Epoch_Schedule_Cut.Output).
proof.
  move=> h.
  rewrite -linear_temporal_exact.
  exact (l3_trace_linear_certificate ops s h).
qed.

(* Non-vacuity: an old capture, a prepared/persisted successor, crash/restart
   and a later snapshot/retry are admitted by the symbolic cut when no matching
   grant has been acquired. *)
op l3_healed_without_grant =
  [OldCapture; Prepare; RemoveError; Crash; Restart; Snapshot; Retry].

lemma l3_nonvacuous_old_capture_is_admitted :
  ! has_item (foldl physical start l3_healed_without_grant).`view
      F4_CC_Observation_Prefix.Output /\
  ! final_view (l3_phases start l3_healed_without_grant)
      (l3_seen start) (Material F4_Epoch_Schedule_Cut.Output).
proof.
  have h : ! has_item (foldl physical start l3_healed_without_grant).`view
      F4_CC_Observation_Prefix.Output
    by rewrite /l3_healed_without_grant /start /physical /empty /merge
      /additem /readout /has_item /=.
  split => //; exact (l3_trace_symbolic_cut l3_healed_without_grant start h).
qed.

(* Hostile conjunction: a peer Welcome and a later grant can be copied from a
   second installation and joined only on retry.  The old local capture does
   not erase either capability.  Consequently this history is not fresh. *)
op l3_cross_install_join =
  [OldCapture; Welcome; Grant; CopyDevice; Retry].

lemma l3_cross_install_combination_reaches_output :
  has_item (foldl physical start l3_cross_install_join).`view
    F4_CC_Observation_Prefix.Output.
proof.
  by rewrite /l3_cross_install_join /start /physical /empty /merge
    /additem /readout /has_item /=.
qed.

lemma l3_cross_install_combination_is_recorded :
  l3_seen (foldl physical start l3_cross_install_join)
    (Material F4_Epoch_Schedule_Cut.Output).
proof.
  by rewrite /l3_cross_install_join /l3_seen /l3_material_seen /start
    /physical /empty /merge /additem /readout /=.
qed.

(* L3 is a symbolic closure theorem, not the computational conclusion C1.
   Passing from the absence of these routes to QPT indistinguishability needs
   the reductions and loss accounting of L5/L6. *)
